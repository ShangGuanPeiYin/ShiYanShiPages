---
import '../styles/global.css';import '../styles/daylight.css';import StarsCanvas from '../components/StarsCanvas.astro';import Text from '../components/Text.astro';import {routes,withBase} from '../lib/site';import site from '../data/site.json';
const {title='MVAS Lab',titleEn=title,description=site.zh.tagline,descriptionEn=site.en.tagline}=Astro.props;const path=Astro.url.pathname;const canonical=new URL(path,Astro.site);canonical.search='';
---
<!doctype html><html lang="zh-CN" data-lang="zh"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description} data-meta-zh={description} data-meta-en={descriptionEn}/><title data-title-zh={`${title} · MVAS Lab`} data-title-en={`${titleEn} · MVAS Lab`}>{title} · MVAS Lab</title><link rel="canonical" href={canonical}/><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml"/><script is:inline>try{const q=new URLSearchParams(location.search).get('lang');document.documentElement.dataset.requestedLang=['zh','en'].includes(q)?q:localStorage.getItem('mvas.lang')==='en'?'en':'zh';}catch{document.documentElement.dataset.requestedLang='zh';}</script></head>
<body class="space-theme"><a class="skip-link" href="#page-main"><Text zh="跳到正文" en="Skip to content"/></a><StarsCanvas/>
<header class="site-header"><nav class="nav container" aria-label="主导航" data-label-zh="主导航" data-label-en="Main navigation" data-nav><a class="brand" href={withBase('/')} aria-label="MVAS Lab 首页" data-label-zh="MVAS Lab 首页" data-label-en="MVAS Lab home"><span class="brand-mark" aria-hidden="true">✳</span><span>MVAS<span class="brand-lab">LAB</span></span></a><details class="mobile-menu" data-menu><summary><Text zh="导航菜单" en="Navigation"/></summary><div class="nav-links">{routes.map(r=><div class="nav-group"><a href={withBase(r.path)} aria-current={path===withBase(r.path)?'page':undefined}><Text zh={r.zh} en={r.en}/></a>{r.children&&<details data-menu><summary><span class="sr-only"><Text zh={`展开${r.zh}`} en={`Expand ${r.en}`}/></span><span aria-hidden="true">⌄</span></summary><div class="submenu">{r.children.map(c=><a href={withBase(c.path)}><Text zh={c.zh} en={c.en}/></a>)}</div></details>}</div>)}</div></details><div class="language-switch" aria-label="语言 Language"><button data-language="zh" aria-pressed="true">中</button><span aria-hidden="true">/</span><button data-language="en" aria-pressed="false">EN</button></div></nav></header>
<main id="page-main"><slot/></main><footer class="footer container"><div class="footer-top"><a class="brand" href={withBase('/')}>✳ MVAS LAB</a><Text as="p" zh={site.zh.department} en={site.en.department}/><a href={`mailto:${site.zh.email}`}>{site.zh.email} ↗</a></div><div class="footer-nav">{routes.flatMap(r=>[{path:r.path,zh:r.zh,en:r.en},...(r.children||[])]).filter((v,i,a)=>a.findIndex(x=>x.path===v.path)===i).map(r=><a href={withBase(r.path)}><Text zh={r.zh} en={r.en}/></a>)}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} MVAS Lab</span><span>Template: <a href="https://github.com/choucisan/SpaceLab" rel="noreferrer">SpaceLab / choucisan</a></span><Text zh="看见 · 理解 · 自主行动" en="See · Understand · Act"/></div></footer>
<script>import '../scripts/site';</script></body></html>
