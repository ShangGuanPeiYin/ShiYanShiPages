---
import {render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Text from '../../components/Text.astro';import ContentField from '../../components/ContentField.astro';import Media from '../../components/Media.astro';import {getPublishedPairs} from '../../lib/content';import {withBase,sectionInfo} from '../../lib/site';import team from '../../data/team.json';
export async function getStaticPaths(){const paths:any[]=[];for(const [section,col] of Object.entries({research:'projects',publications:'publications',news:'news',blogs:'blogs',collections:'collections','paper-sites':'paperSites'})){for(const pair of await getPublishedPairs(col))paths.push({params:{section,slug:pair.id},props:{pair}});}for(const person of team)paths.push({params:{section:'our-team',slug:person.slug},props:{person}});return paths;}
const {pair,person}=Astro.props;const {section}=Astro.params;const z=pair?.zh.data,e=pair?.en?.data;const title=person?person.name.zh:z.title,titleEn=person?person.name.en:e?.title||title;const hasZhBody=!!pair?.zh.body?.trim(),hasEnBody=!!pair?.en?.body?.trim();const ZhBody=hasZhBody?(await render(pair.zh)).Content:null,EnBody=hasEnBody?(await render(pair.en)).Content:null;
---
<BaseLayout title={title} titleEn={titleEn} description={z?.description||title} descriptionEn={e?.description||titleEn}><article class="container"><header class="page-header"><a class="text-link" href={withBase(`/${section}/`)}>← <Text zh={sectionInfo[section!].zh} en={sectionInfo[section!].en}/></a><p class="eyebrow" style="margin-top:30px">MVAS / {sectionInfo[section!].kicker}</p><Text as="h1" zh={title} en={titleEn}/></header><div class="prose">
{person?<><Media src={person.photo} alt={person.name.zh}/><Text as="p" zh={person.role.zh} en={person.role.en}/><Text as="p" zh={person.groupLabel.zh} en={person.groupLabel.en}/>{person.email&&<p><a href={`mailto:${person.email}`}>{person.email}</a></p>}{['homepage','scholar','github'].map(k=>(person as any)[k]&&<p><a href={(person as any)[k]}>{k} ↗</a></p>)}{person.projectIds.map((id:string)=><a href={withBase(`/research/${id}/`)}>{id}</a>)}{person.publicationIds.map((id:string)=><a href={withBase(`/publications/${id}/`)}>{id}</a>)}</>:<>
<Text as="p" zh={z.description} en={e?.description} fallback/>{(z.year||z.authorsText||z.venue||z.sourceDate||z.pubDate||z.eventDate||z.category||e?.category)&&<div class="detail-meta">{z.year&&<p>{z.year}</p>}{z.authorsText&&<p>{z.authorsText}</p>}{z.venue&&<p>{z.venue}</p>}{(z.pubDate||z.eventDate||z.sourceDate)&&<p><Text zh={z.pubDate?'发布日期':z.eventDate?'事件日期':'日期'} en={z.pubDate?'Published':z.eventDate?'Event date':'Date'}/> · <time datetime={z.pubDate||z.eventDate||z.sourceDate}>{z.pubDate||z.eventDate||z.sourceDate}</time></p>}<Text as="p" zh={z.category} en={e?.category}/></div>}
{z.video?<Media video={z.video} poster={z.image} alt={z.title}/>:z.image&&<Media src={z.image} alt={z.title}/>}
{[['challenge','研究挑战','Research challenge'],['approach','研究方法','Approach']].map(([k,zh,en])=><ContentField zh={z[k]} en={e?.[k]} headingZh={zh} headingEn={en}/>)}
<ContentField zh={z.outcomes} en={e?.outcomes} headingZh="已有成果" headingEn="Outcomes"/>
{(hasZhBody||hasEnBody)&&<div data-localized><div data-locale-block="zh" lang={hasZhBody?'zh-CN':'en'}>{ZhBody?<ZhBody/>:EnBody&&<EnBody/>}</div><div data-locale-block="en" hidden lang={hasEnBody?'en':'zh-CN'}>{EnBody?<EnBody/>:ZhBody&&<><ZhBody/><small class="translation-note">Chinese original · English translation not provided</small></>}</div></div>}
<div class="detail-links">{(z.links||[]).map((l:any)=><a class="button quiet" href={l.href} rel="noreferrer">{l.label} ↗</a>)}{z.githubUrl&&<a href={z.githubUrl}>GitHub ↗</a>}{z.huggingfaceUrl&&<a href={z.huggingfaceUrl}>Hugging Face ↗</a>}{z.paperSite&&<a href={withBase(`/paper-sites/${z.paperSite}/`)}><Text zh="项目展示" en="Project page"/> ↗</a>}</div>
{section==='research'&&<p><a class="button" href={withBase('/join/')}><Text zh="对这个研究感兴趣？加入我们" en="Interested in this research? Join us"/> ↗</a></p>}
</>}
</div></article></BaseLayout>
