---
import BaseLayout from '../../layouts/BaseLayout.astro';import Text from '../../components/Text.astro';import ContentField from '../../components/ContentField.astro';import Card from '../../components/Card.astro';import PersonCard from '../../components/PersonCard.astro';import Filters from '../../components/Filters.astro';import Empty from '../../components/Empty.astro';import {getPublishedPairs} from '../../lib/content';import {withBase,sectionInfo} from '../../lib/site';import site from '../../data/site.json';import join from '../../data/join.json';import team from '../../data/team.json';
export function getStaticPaths(){return Object.keys(sectionInfo).map(section=>({params:{section}}));}
const {section}=Astro.params;const info=sectionInfo[section!];const collection=section==='research'?'projects':section==='paper-sites'?'paperSites':section;const isList=['research','publications','news','blogs','collections','paper-sites'].includes(section!);const pairs=isList?await getPublishedPairs(collection!):[];const directions=section==='research'||section==='join'?await getPublishedPairs('directions'):[];
---
<BaseLayout title={info.zh} titleEn={info.en}><div class="container"><header class="page-header"><p class="eyebrow">MVAS / {info.kicker}</p><Text as="h1" zh={info.zh} en={info.en}/>{section==='research'&&<Text as="p" zh={site.zh.tagline} en={site.en.tagline}/>}</header>
{isList&&<><p class="notice" data-missing-project hidden><Text zh="没有找到指定项目，请从以下真实项目中选择。" en="Project not found. Please choose a project below."/></p>{section==='research'&&<section class="prose"><Text as="h2" zh="研究方向与匹配说明" en="Research directions & fit"/>{!directions.length&&<Text as="p" zh="方向的研究问题、建议背景或技能与专项准备材料正在整理。可先浏览以下代表项目；具体招生信息请联系实验室。" en="Research questions, suggested backgrounds and direction-specific materials are being prepared. Explore the projects below and contact the lab for current recruitment information."/>}{directions.map(p=><section id={`direction-${p.id}`}><Text as="h3" zh={p.zh.data.title} en={p.en?.data.title}/>{['question','suggestedBackgrounds','materials'].map(k=><ContentField zh={p.zh.data[k]} en={p.en?.data[k]} headingZh={{question:'研究问题',suggestedBackgrounds:'建议背景与技能',materials:'准备材料'}[k]} headingEn={{question:'Research question',suggestedBackgrounds:'Suggested backgrounds & skills',materials:'Materials'}[k]}/>)}{p.zh.data.projectIds.map((id:string)=><p><a href={withBase(`/research/${id}/`)}>{id} ↗</a></p>)}<a href={withBase(`/join/?direction=${p.id}`)}><Text zh="了解这个方向的申请" en="Apply for this direction"/> →</a></section>)}</section>}{pairs.length?<><Filters section={section} pairs={pairs}/><div class={section==='publications'?'paper-list':'card-grid'}>{pairs.map(pair=><Card pair={pair} section={section}/>)}</div></>:<Empty/>}</>}
{section==='our-team'&&<>{team.length?<><Filters section="our-team"/><div class="team-grid">{['负责人','研究人员','学生','校友'].map(group=><><Text class="team-group" as="h2" zh={group} en={{'负责人':'Principal investigator','研究人员':'Researchers','学生':'Students','校友':'Alumni'}[group]} data-team-heading={group}/>{team.filter(p=>p.group===group).map(person=><PersonCard person={person}/>)}</>)}</div></>:<Empty/>}</>}
{section==='about'&&<div class="prose"><Text as="h2" zh={site.zh.labName} en={site.en.labName}/><Text as="p" zh={site.zh.department} en={site.en.department}/><Text as="p" zh={site.zh.tagline} en={site.en.tagline}/><Text as="p" zh={join.zh.intro} en={join.en.intro}/><p><a href={withBase('/research/')}><Text zh="探索研究项目" en="Explore research projects"/> ↗</a></p></div>}
{section==='join'&&<div class="prose"><Text as="p" zh={join.zh.intro} en={join.en.intro}/><Text as="h2" zh="你可以从这里开始" en="Ways to join"/><ul>{join.zh.roles.map((r,i)=><Text as="li" zh={r} en={join.en.roles[i]}/>)}</ul><Text as="h2" zh="认识研究，判断匹配" en="Explore research & find your fit"/><Text as="p" zh="先了解代表项目，再通过邮件交流研究兴趣。方向专项说明尚未提供时，不将建议经验视为硬性要求。" en="Explore representative projects, then discuss your research interests by email. Suggested experience is not a formal admission requirement."/><p><a href={withBase('/research/')}><Text zh="查看研究方向与项目" en="View directions and projects"/> ↗</a></p><p data-selected-direction data-directions={JSON.stringify(directions.map(p=>({id:p.id,zh:p.zh.data.title,en:p.en?.data.title||p.zh.data.title})))}></p><Text as="h2" zh="联系前准备" en="Materials to prepare"/><ul>{join.zh.materials.map((r,i)=><Text as="li" zh={r} en={join.en.materials[i]}/>)}</ul>{join.zh.process.length>0&&<ul>{join.zh.process.map((r,i)=><Text as="li" zh={r} en={join.en.process[i]}/>)}</ul>}<div class="detail-links"><a class="button" data-join-mail href={`mailto:${join.zh.contact}`}><Text zh="邮件联系" en="Contact by email"/> ↗</a><button class="button quiet" data-copy={join.zh.contact}><Text zh="复制邮箱" en="Copy email"/></button></div><p>{join.zh.contact}</p><p data-copy-status role="status"></p></div>}
{section==='contact'&&<div class="contact-grid"><div class="prose"><Text as="h2" zh="邮箱" en="Email"/><p><a href={`mailto:${site.zh.email}`}>{site.zh.email}</a></p><button class="button quiet" data-copy={site.zh.email}><Text zh="复制邮箱" en="Copy email"/></button><p data-copy-status role="status"></p></div><div class="prose"><Text as="h2" zh="找到我们" en="Find us"/><Text as="p" zh={site.zh.address} en={site.en.address}/><Text as="p" zh={site.zh.department} en={site.en.department}/><a href={site.zh.university.url}><Text zh={site.zh.university.name} en={site.en.university.name}/> ↗</a></div></div>}
{section==='faq'&&(join.zh.faqs.length?<div class="prose">{join.zh.faqs.map((f:any,i:number)=><details><summary><Text zh={f.question} en={(join.en.faqs[i] as any)?.question}/></summary><Text as="p" zh={f.answer} en={(join.en.faqs[i] as any)?.answer} fallback/></details>)}</div>:<Empty/>)}
</div></BaseLayout>
