---
import BaseLayout from '../layouts/BaseLayout.astro';import Text from '../components/Text.astro';import GlobeMap from '../components/GlobeMap.astro';import Card from '../components/Card.astro';import Empty from '../components/Empty.astro';import PersonCard from '../components/PersonCard.astro';import {getPublishedPairs} from '../lib/content';import {withBase} from '../lib/site';import site from '../data/site.json';import team from '../data/team.json';
const projects=await getPublishedPairs('projects'),papers=await getPublishedPairs('publications'),news=await getPublishedPairs('news'),blogs=await getPublishedPairs('blogs'),collections=await getPublishedPairs('collections');
---
<BaseLayout title="机器视觉与自主系统实验室" titleEn="Machine Vision and Autonomous Systems Laboratory"><div class="container">
<section class="hero"><div class="hero-copy"><p class="eyebrow">SHANGHAI JIAO TONG UNIVERSITY / MVAS LAB</p><Text as="h1" zh={site.zh.labName} en={site.en.labName}/><p class="hero-english" lang="en">Machine Vision and<br/>Autonomous Systems Laboratory</p><Text as="p" zh={site.zh.tagline} en={site.en.tagline}/><Text as="p" zh={site.zh.department} en={site.en.department}/><div class="hero-actions"><a class="button" href={withBase('/research/')}><Text zh="了解研究" en="Explore research"/> ↗</a><a class="button quiet" href={withBase('/join/')}><Text zh="加入我们" en="Join us"/> →</a></div></div><GlobeMap/><div class="hero-bottom"><span>VISION · ROBOTICS · AUTONOMY</span><a href="#research"><Text zh="向下探索" en="SCROLL TO EXPLORE"/> ↓</a></div></section>
<section class="section" id="research"><div class="section-head"><div><span class="section-number">01 / RESEARCH</span><Text as="h2" zh="从感知，走向行动" en="From perception to action"/></div><a class="text-link" href={withBase('/research/')}><Text zh="全部研究" en="All research"/> ↗</a></div>{projects.length?<div class="card-grid">{projects.slice(0,3).map(pair=><Card pair={pair} section="research"/>)}</div>:<Empty/>}</section>
<section class="section" id="team"><div class="section-head"><div><span class="section-number">02 / PEOPLE</span><Text as="h2" zh="探索，因同行而不同" en="Exploration is a shared journey"/></div><a class="text-link" href={withBase('/our-team/')}><Text zh="认识团队" en="Meet the team"/> ↗</a></div>{team.length?<div class="card-grid">{team.slice(0,3).map(person=><PersonCard person={person}/>)}</div>:<Empty/>}</section>
<section class="section" id="publications"><div class="section-head"><div><span class="section-number">03 / PUBLICATIONS</span><Text as="h2" zh="研究的记录" en="Research in print"/></div><a class="text-link" href={withBase('/publications/')}><Text zh="全部论文" en="All publications"/> ↗</a></div>{papers.length?<div class="paper-list">{papers.slice(0,3).map(pair=><Card pair={pair} section="publications"/>)}</div>:<Empty/>}</section>
<section class="section" id="news"><div class="section-head"><div><span class="section-number">04 / NEWS</span><Text as="h2" zh="实验室动态" en="Lab news"/></div><a class="text-link" href={withBase('/news/')}><Text zh="全部动态" en="All news"/> ↗</a></div>{news.length?<div class="card-grid">{news.slice(0,3).map(pair=><Card pair={pair} section="news"/>)}</div>:<Empty/>}</section>
<section class="section split-section" id="resources">{[{id:'collections',zh:'开放，共享',en:'Open & shared',n:'05 / OPEN RESOURCES',items:collections},{id:'blogs',zh:'思考与手记',en:'Ideas & notes',n:'06 / BLOG',items:blogs}].map(s=><div><div class="section-head"><div><span class="section-number">{s.n}</span><Text as="h2" zh={s.zh} en={s.en}/></div><a href={withBase(`/${s.id}/`)} aria-label={s.zh} data-label-zh={s.zh} data-label-en={s.en}>↗</a></div>{s.items.length?s.items.slice(0,3).map(pair=><Card pair={pair} section={s.id}/>):<Empty/>}</div>)}</section>
<section class="section" id="join"><div class="join-banner"><div><p class="eyebrow">YOUR NEXT CHAPTER</p><Text as="h2" zh="把好奇，带进真实世界。" en="Bring your curiosity into the real world."/><Text as="p" zh="了解我们的研究，找到你的探索起点。" en="Explore our work and find your starting point."/></div><a class="button" href={withBase('/join/')}><Text zh="加入 MVAS Lab" en="Join MVAS Lab"/> ↗</a></div></section>
</div></BaseLayout>
