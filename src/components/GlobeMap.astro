---
import Text from './Text.astro';import {getPublishedPairs} from '../lib/content';
const markers=(await getPublishedPairs('markers')).map(p=>({...p.zh.data,titleEn:p.en?.data.title}));
---
<div class="globe-panel" data-globe data-state="idle" data-markers={JSON.stringify(markers)} data-token={import.meta.env.PUBLIC_MAPBOX_TOKEN||''} data-style={import.meta.env.PUBLIC_MAPBOX_STYLE||'mapbox://styles/mapbox/satellite-streets-v12'}>
<div class="globe-visual"><div class="static-earth" role="img" aria-label="MVAS 太空主题静态地球" data-label-zh="MVAS 太空主题静态地球" data-label-en="MVAS static globe visual"><div class="earth-land"></div></div><div class="orbit-ring"></div><div class="globe-container" data-map-container></div></div>
<p class="globe-caption">EARTH / SHARED EXPLORATIONS</p>
<div class="map-tools"><form data-map-search><label class="sr-only" for="map-query"><Text zh="地点或纬度,经度" en="Place or latitude,longitude"/></label><input id="map-query" data-map-query placeholder="地点 / 纬度,经度" data-placeholder-zh="地点 / 纬度,经度" data-placeholder-en="Place / latitude,longitude"/><button class="button quiet" type="submit"><Text zh="定位" en="Go"/></button></form><p class="map-status" data-map-status role="status"><Text zh="正在准备地球；您可继续浏览研究内容。" en="Preparing globe. You can continue browsing."/></p><div class="map-footer"><button class="button quiet" data-map-retry type="button"><Text zh="重试地球" en="Retry globe"/></button><label><Text zh="缩放档位" en="Zoom preset"/><select data-map-zoom aria-label="缩放档位 Zoom preset">{[[10,'10 km'],[12,'5 km'],[13,'1 km'],[16,'100 m'],[19,'10 m']].map(([v,t])=><option value={v}>{t}</option>)}</select></label><Text zh="档位名称，非精确距离" en="Preset labels, not exact distances"/></div><div class="map-results" data-map-results></div><details><summary><Text zh="会议与团队足迹" en="Conferences & team activities"/></summary><label><Text zh="搜索足迹" en="Search activities"/><input type="search" data-marker-query/></label><div data-marker-results></div></details></div>
<dialog data-marker-dialog><form method="dialog"><button class="button quiet" autofocus><Text zh="关闭" en="Close"/></button></form><h2 data-marker-title></h2><img data-marker-image alt=""/><p data-marker-credit></p><p data-marker-count aria-live="polite"></p><button class="button quiet" data-marker-prev><Text zh="上一张" en="Previous"/></button><button class="button quiet" data-marker-next><Text zh="下一张" en="Next"/></button></dialog>
</div>
<script>import '../scripts/globe';</script>
