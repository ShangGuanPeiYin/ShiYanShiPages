---
import Text from './Text.astro';import tags from '../data/tags.json';
const {section,pairs=[]}=Astro.props;const years=[...new Set<number>(pairs.map((p:any)=>p.zh.data.year).filter(Boolean))].sort((a:any,b:any)=>b-a);const types=[...new Set<string>(pairs.map((p:any)=>p.zh.data.type||'unclassified'))];const tagIds=[...new Set(pairs.flatMap((p:any)=>p.zh.data.tags||[]))] as string[];const categories=[...new Set(pairs.map((p:any)=>p.zh.data.category).filter(Boolean))] as string[];
---
<form class="filters" data-filters role="search"><label><Text zh="关键词" en="Keywords"/><input name="q" type="search" data-placeholder-zh="搜索标题、作者或关键词" data-placeholder-en="Search titles, authors or keywords" placeholder="搜索标题、作者或关键词"/></label>
{section==='publications'&&<><label><Text zh="年份" en="Year"/><select name="year"><option value="" data-zh="全部年份" data-en="All years">全部年份</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label><Text zh="类型" en="Type"/><select name="type"><option value="" data-zh="全部类型" data-en="All types">全部类型</option>{types.map(t=><option value={t} data-zh={t==='unclassified'?'未分类':t==='journal'?'期刊':t} data-en={t==='unclassified'?'Unclassified':t}>{t==='unclassified'?'未分类':t==='journal'?'期刊':t}</option>)}</select></label></>}
{section==='research'&&<label><Text zh="标签" en="Tag"/><select name="tag"><option value="" data-zh="全部标签" data-en="All tags">全部标签</option>{tagIds.map(id=><option value={id} data-zh={(tags as any)[id]?.zh||id} data-en={(tags as any)[id]?.en||id}>{(tags as any)[id]?.zh||id}</option>)}</select></label>}
{categories.length>0&&<label><Text zh="分类" en="Category"/><select name="category"><option value="" data-zh="全部分类" data-en="All categories">全部分类</option>{categories.map(c=><option value={c} data-zh={c} data-en={pairs.find((p:any)=>p.zh.data.category===c)?.en?.data.category||c}>{c}</option>)}</select></label>}
{section==='our-team'&&<label><Text zh="分组" en="Group"/><select name="group"><option value="" data-zh="全部成员" data-en="All people">全部成员</option>{[['负责人','Principal investigator'],['研究人员','Researchers'],['学生','Students'],['校友','Alumni']].map(([zh,en])=><option value={zh} data-zh={zh} data-en={en}>{zh}</option>)}</select></label>}
<button type="reset" class="button quiet"><Text zh="清除筛选" en="Clear filters"/></button><p class="filter-status" aria-live="polite" data-filter-status></p></form>
<p class="empty-state" data-no-results hidden><Text zh="没有匹配结果，请清除筛选后重试。" en="No matches. Clear filters and try again."/></p>
