{
  "name": "mvas-spacelab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-content.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/check-branch.mjs && node scripts/check-content.mjs && astro build && node scripts/postbuild.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:fixtures": "node scripts/check-fixtures.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.4",
    "astro": "6.1.9",
    "mapbox-gl": "3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "5.9.3",
    "@playwright/test": "1.58.2",
    "yaml": "2.9.1"
  }
}
